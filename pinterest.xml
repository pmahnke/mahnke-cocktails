---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.title }}</title>
    <link>{{ site.url }}</link>
    <description>{{ site.description }}</description>
    
    {% assign recipe_pages = site.pages | where: "layout", "recipe" | sort: "date" | reverse %}
    {% for recipe in recipe_pages limit:30 %}
    <item>
      <title>{{ recipe.title }}</title>
      <link>{{ site.url }}{{ recipe.url | replace:'index.html','' }}</link>
      <description>{{ recipe.description | strip_html | xml_escape }}</description>
      {% if recipe.slug %}
      <media:content url="{{ site.url }}/assets/images/pinterest/{{ recipe.slug }}_pin.png" medium="image" type="image/png" />
      {% endif %}
    </item>
    {% endfor %}
    
  </channel>
</rss>